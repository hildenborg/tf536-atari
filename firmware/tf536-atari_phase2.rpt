********** Mapped Logic **********

ARAM<0>.D = A<11> & !col & ready
	# A<2> & col & ready;
   ARAM<0>.CLK = CLK100M;	// GCK    

!ARAM<1>.D = !A<12> & !col & ready
	# !A<3> & col & ready;
   ARAM<1>.CLK = CLK100M;	// GCK    

ARAM<2>.D = A<13> & !col & ready
	# A<4> & col & ready;
   ARAM<2>.CLK = CLK100M;	// GCK    

