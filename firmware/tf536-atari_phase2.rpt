	# A<8> & col & ready;
   ARAM<6>.CLK = CLK100M;	// GCK    

ARAM<7>.D = A<18> & !col & ready
	# A<9> & col & ready;
   ARAM<7>.CLK = CLK100M;	// GCK    

ARAM<8>.D = A<19> & !col & ready
	# A<10> & col & ready
	# !col & ready & p_ovl;
   ARAM<8>.CLK = CLK100M;	// GCK    

!ARAM<9>.D = col & ready
	# !A<20> & ready & !p_ovl;
   ARAM<9>.CLK = CLK100M;	// GCK    

ARAM<10>.D = !inum<1> & !ready
	# A<21> & !col & ready
	# !col & ready & p_ovl
	# !CIIN & col & z_xfer & ready & xold;
   ARAM<10>.CLK = CLK100M;	// GCK    

ARAM<11>.D = A<22> & !col & ready
	# !col & ready & p_ovl;
   ARAM<11>.CLK = CLK100M;	// GCK    

ARAM<12>.D = A<23> & !col & ready
	# !col & ready & p_ovl;
   ARAM<12>.CLK = CLK100M;	// GCK    

!AS = !AS30 & m_as;
   AS.OE = BGACK & drv;    

AVEC.D = Gnd;
   AVEC.CLK = CLK100M;	// GCK
   AVEC.AP = AS30;
   AVEC.CE = m_s4 & p_cpu & cd<1> & !q1 & !vp2;    

BA<0>.D = A<24> & ready & !p_ovl;
   BA<0>.CLK = CLK100M;	// GCK    

BA<1>.D = A<25> & ready & !p_ovl;
   BA<1>.CLK = CLK100M;	// GCK    

BERR = Gnd;
   BERR.OE = !AS30 & berr_rnm0;    

!BG.D = as2 & as3 & !mbt & !bg2 & !bg3 & BUSEN;
   BG.CLK = CLK100M;	// GCK    

BGACK30 = BGACK;    

BR30 = BR;    

BUSEN.D = !m_as & BUSEN
	# !m_as & as2 & as3 & as4;
   BUSEN.CLK = CLK100M;	// GCK    

!CAS.D = RW30 & rst2 & z_rcd
	# rq & rst2 & z_idle & i_cas
	# !RW30 & CIIN & !wdone & rst2 & z_xfer & !ds2;
   CAS.CLK = CLK100M;	// GCK    

!CBACK.D = !A<3> & RW30 & CIIN & !A<2> & !as2 & !as1 & !cq2 & 
	!p_vec;
   CBACK.CLK = CLK100M;	// GCK
   CBACK.AP = AS30;
   CBACK.CE = STERM;    

CIIN.D = CIIN & !as2 & !as3
	# !as2 & !p_cpu & p_ovl & as3
	# !as2 & !p_cpu & as3 & !p_prot & p_ram;
   CIIN.CLK = CLK100M;	// GCK    

CLKCPU.D = !rst2 & !q1
	# mbt & !q1
	# !q1 & !ba2
	# !CLKCPU & rst2 & !idt & !mbt & ba2
	# rst2 & tc<2> & !as1 & idt & !mbt & ba2;
   CLKCPU.CLK = CLK100M;	// GCK    

