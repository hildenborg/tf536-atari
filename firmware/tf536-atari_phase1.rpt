*******************************  Equations  ********************************

********** Mapped Logic **********

FDCPE FDCPE_ARAM0 (ARAM[0],ARAM_D[0],CLK100M,1'b0,1'b0);
assign ARAM_D[0] = ((A[11] && !col && ready)
	|| (A[2] && col && ready));

FDCPE FDCPE_ARAM1 (ARAM[1],ARAM_D[1],CLK100M,1'b0,1'b0);
assign ARAM_D[1] = ((!A[12] && !col && ready)
	|| (!A[3] && col && ready));

FDCPE FDCPE_ARAM2 (ARAM[2],ARAM_D[2],CLK100M,1'b0,1'b0);
assign ARAM_D[2] = ((A[13] && !col && ready)
	|| (A[4] && col && ready));

FDCPE FDCPE_ARAM3 (ARAM[3],ARAM_D[3],CLK100M,1'b0,1'b0);
assign ARAM_D[3] = ((A[14] && !col && ready)
	|| (A[5] && col && ready));

FDCPE FDCPE_ARAM4 (ARAM[4],ARAM_D[4],CLK100M,1'b0,1'b0);
assign ARAM_D[4] = ((A[6] && col && ready)
	|| (A[15] && !col && ready));

FDCPE FDCPE_ARAM5 (ARAM[5],ARAM_D[5],CLK100M,1'b0,1'b0);
assign ARAM_D[5] = ((!A[16] && !col && ready)
	|| (!A[7] && col && ready));

FDCPE FDCPE_ARAM6 (ARAM[6],ARAM_D[6],CLK100M,1'b0,1'b0);
assign ARAM_D[6] = ((A[17] && !col && ready)
	|| (A[8] && col && ready));

FDCPE FDCPE_ARAM7 (ARAM[7],ARAM_D[7],CLK100M,1'b0,1'b0);
assign ARAM_D[7] = ((A[18] && !col && ready)
	|| (A[9] && col && ready));

FDCPE FDCPE_ARAM8 (ARAM[8],ARAM_D[8],CLK100M,1'b0,1'b0);
assign ARAM_D[8] = ((A[19] && !col && ready)
	|| (A[10] && col && ready)
	|| (!col && ready && p_ovl));

FDCPE FDCPE_ARAM9 (ARAM[9],ARAM_D[9],CLK100M,1'b0,1'b0);
assign ARAM_D[9] = ((col && ready)
	|| (!A[20] && ready && !p_ovl));

FDCPE FDCPE_ARAM10 (ARAM[10],ARAM_D[10],CLK100M,1'b0,1'b0);
assign ARAM_D[10] = ((!inum[1] && !ready)
	|| (A[21] && !col && ready)
	|| (!col && ready && p_ovl)
	|| (!CIIN && col && z_xfer && ready && xold));

FDCPE FDCPE_ARAM11 (ARAM[11],ARAM_D[11],CLK100M,1'b0,1'b0);
assign ARAM_D[11] = ((A[22] && !col && ready)
	|| (!col && ready && p_ovl));

FDCPE FDCPE_ARAM12 (ARAM[12],ARAM_D[12],CLK100M,1'b0,1'b0);
assign ARAM_D[12] = ((A[23] && !col && ready)
	|| (!col && ready && p_ovl));


assign AS_I = !((!AS30 && m_as));
assign AS = AS_OE ? AS_I : 1'bZ;
assign AS_OE = (BGACK && drv);

FDCPE FDCPE_AVEC (AVEC,1'b0,CLK100M,1'b0,AS30,AVEC_CE);
assign AVEC_CE = (m_s4 && p_cpu && cd_0 && !q1 && !vp2);

FDCPE FDCPE_BA0 (BA[0],BA_D[0],CLK100M,1'b0,1'b0);
assign BA_D[0] = (A[24] && ready && !p_ovl);

FDCPE FDCPE_BA1 (BA[1],BA_D[1],CLK100M,1'b0,1'b0);
assign BA_D[1] = (A[25] && ready && !p_ovl);


assign BERR_I = 1'b0;
assign BERR = BERR_OE ? BERR_I : 1'bZ;
assign BERR_OE = (!AS30 && berr_rnm0);

FDCPE FDCPE_BG (BG,BG_D,CLK100M,1'b0,1'b0);
assign BG_D = (as2 && as3 && !mbt && !bg2 && !bg3 && BUSEN);


assign BGACK30 = BGACK;


assign BR30 = BR;

FDCPE FDCPE_BUSEN (BUSEN,BUSEN_D,CLK100M,1'b0,1'b0);
